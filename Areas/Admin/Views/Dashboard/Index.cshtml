@model btl_webnc_G08.Models.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Tổng quan thống kê";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a></li>
        <li class="breadcrumb-item active" aria-current="page">Tổng quan</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Tổng quan thống kê hệ thống</h1>
    <a asp-area="Admin" asp-controller="Vehicle" asp-action="Index" class="btn btn-primary btn-sm">
        <i class="bi bi-car-front me-1"></i>Quản lý phương tiện
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-primary h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-uppercase fw-bold text-primary small">Tổng số phương tiện</span>
                    <i class="bi bi-car-front fs-4 text-primary"></i>
                </div>
                <div class="h3 mb-2 fw-bold">@Model.TotalVehicles</div>
                <div class="small text-muted">
                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>Sẵn sàng: @Model.AvailableVehicles</span> | 
                    <span class="text-primary"><i class="bi bi-arrow-repeat me-1"></i>Đang thuê: @Model.InUseVehicles</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-success h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-uppercase fw-bold text-success small">Đơn đặt xe</span>
                    <i class="bi bi-calendar-check fs-4 text-success"></i>
                </div>
                <div class="h3 mb-2 fw-bold">@Model.TotalBookings</div>
                <div class="small text-muted">
                    <span class="text-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt: @Model.PendingBookings</span> | 
                    <span class="text-success"><i class="bi bi-check-all me-1"></i>Hoàn thành: @Model.CompletedBookings</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-info h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-uppercase fw-bold text-info small">Cư dân thành viên</span>
                    <i class="bi bi-people fs-4 text-info"></i>
                </div>
                <div class="h3 mb-2 fw-bold">@Model.TotalUsers</div>
                <div class="small text-muted">
                    <span class="text-success"><i class="bi bi-person-check me-1"></i>Hoạt động: @Model.ActiveUsers</span> | 
                    <span class="text-secondary"><i class="bi bi-geo-alt me-1"></i>Khu dân cư: @Model.TotalCommunities</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-warning h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-uppercase fw-bold text-warning text-dark small">Doanh thu &amp; Báo cáo</span>
                    <i class="bi bi-cash-coin fs-4 text-warning"></i>
                </div>
                <div class="h3 mb-2 fw-bold">@Model.TotalEstimatedRevenue.ToString("N0") đ</div>
                <div class="small text-muted">
                    <span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Báo cáo chờ xử lý: @Model.PendingReports</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light py-3">
                <h6 class="m-0 fw-bold text-dark"><i class="bi bi-pie-chart me-2"></i>Cơ cấu phương tiện theo danh mục</h6>
            </div>
            <div class="card-body">
                @if (Model.CategoryStats.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var cat in Model.CategoryStats)
                                {
                                    <tr>
                                        <td style="width: 40%;" class="fw-medium">@cat.CategoryName</td>
                                        <td style="width: 45%;">
                                            <div class="progress" style="height: 10px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @cat.Percentage%" aria-valuenow="@cat.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                        <td style="width: 15%;" class="text-end small text-muted">@cat.VehicleCount xe</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small py-3 text-center">Chưa có dữ liệu danh mục.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-dark"><i class="bi bi-clock-history me-2"></i>Đơn đặt xe mới nhất</h6>
                <a asp-area="Admin" asp-controller="Vehicle" asp-action="Index" class="small text-decoration-none">Xem xe</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Phương tiện</th>
                                <th>Người mượn</th>
                                <th>Thời gian</th>
                                <th>Phí ước tính</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.RecentBookings.Any())
                            {
                                @foreach (var b in Model.RecentBookings)
                                {
                                    <tr>
                                        <td class="fw-semibold">@b.VehicleName</td>
                                        <td>@b.BorrowerName</td>
                                        <td>@b.StartAt.ToString("dd/MM/yyyy") - @b.EndAt.ToString("dd/MM/yyyy")</td>
                                        <td>@(b.Fee == 0 ? "Miễn phí" : b.Fee.ToString("N0") + " đ")</td>
                                        <td>
                                            <span class="badge @b.StatusBadgeClass">@b.StatusName</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Chưa có đơn đặt xe nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light py-3">
        <h6 class="m-0 fw-bold text-dark"><i class="bi bi-shield-exclamation me-2"></i>Báo cáo vi phạm &amp; Phản ánh gần đây</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 60px;">Mã</th>
                        <th>Người báo cáo</th>
                        <th>Đối tượng</th>
                        <th>Lý do vi phạm</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.RecentReports.Any())
                    {
                        @foreach (var r in Model.RecentReports)
                        {
                            <tr>
                                <td>#@r.Id</td>
                                <td class="fw-medium">@r.ReporterName</td>
                                <td><span class="badge bg-light text-dark border">@r.TargetType</span></td>
                                <td>@r.Reason</td>
                                <td>
                                    <span class="badge @r.StatusBadgeClass">@r.StatusName</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Chưa có báo cáo vi phạm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
