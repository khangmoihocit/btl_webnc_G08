@using btl_webnc_G08.Models.Entities
@using static btl_webnc_G08.Models.Enums.AppEnums
@{ViewData["Title"]="Đánh giá và báo cáo";ViewData["Robots"]="noindex, nofollow";var uid=(string)ViewBag.CurrentId;}
<div class="container py-5"><h1>Đánh giá, phản hồi và báo cáo vi phạm</h1>
@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<section class="card p-4 my-4"><h2>Đánh giá giao dịch hoàn thành</h2><form asp-action="Review" method="post" class="d-grid gap-2"><label>Giao dịch <select name="BookingId" class="form-select" required><option value="">Chọn giao dịch</option>@foreach(Booking b in ViewBag.Bookings){<option value="@b.Id">#@b.Id - @b.Vehicle.Name</option>}</select></label><label>Điểm <select name="Rating" class="form-select" required><option value="">Chọn số sao</option>@for(int i=1;i<=5;i++){<option value="@i">@i sao</option>}</select></label><label>Nhận xét <textarea name="Comment" maxlength="1000" class="form-control"></textarea></label><button class="btn btn-primary">Gửi đánh giá</button></form></section>
<section class="card p-4 my-4"><h2>Đánh giá của tôi</h2>@foreach(Review r in ViewBag.Reviews){<article class="border rounded p-3 my-2"><strong>@r.Booking.Vehicle.Name · @r.Rating/5 sao · @r.Reviewer.FullName</strong><p style="white-space:pre-wrap">@r.Comment</p>@if(r.IsHidden){<p>Đánh giá đã bị ẩn.</p>}@if(r.Reply!=null){<p><strong>Phản hồi:</strong> @r.Reply</p>}else if(r.RevieweeId==uid&&!r.IsHidden){<form asp-action="Reply" method="post"><input type="hidden" name="id" value="@r.Id"/><label>Phản hồi<textarea name="Content" class="form-control" required minlength="5" maxlength="500"></textarea></label><button class="btn btn-outline-primary mt-2">Gửi phản hồi</button></form>}</article>}</section>
<section class="card p-4 my-4"><h2>Báo cáo vi phạm</h2><p>Chọn loại và nhập mã đối tượng liên quan.</p><form asp-action="Report" method="post" class="d-grid gap-2"><label>Loại đối tượng <select name="TargetType" class="form-select"><option value="Vehicle">Phương tiện</option><option value="User">Tài khoản</option><option value="Booking">Giao dịch</option></select></label><label>Mã đối tượng <input name="TargetId" class="form-control" maxlength="450" required /></label><label>Lý do <input name="Reason" class="form-control" minlength="5" maxlength="200" required /></label><label>Mô tả <textarea name="Description" class="form-control" minlength="10" maxlength="1500" required></textarea></label><button class="btn btn-primary">Gửi báo cáo</button></form></section>
<section class="card p-4 my-4"><h2>Thông báo</h2>@foreach(Notification n in ViewBag.Notifications){<p>@n.Content — @n.CreatedAt.ToLocalTime()</p>}</section>
<section class="card p-4 my-4"><h2>Báo cáo đã gửi</h2>@foreach(ViolationReport r in ViewBag.Reports){<article class="border rounded p-3 my-2"><strong>BC@r.Id · @r.TargetType #@r.TargetId · @r.Status</strong><p>@r.Reason — @r.Description</p><p>Kết quả: @(r.AdminNote??"Chưa có")</p></article>}</section></div>
