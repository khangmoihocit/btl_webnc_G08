@using btl_webnc_G08.Models.Entities
@using static btl_webnc_G08.Models.Enums.AppEnums
@{ViewData["Title"]="Quản trị";ViewData["Robots"]="noindex, nofollow";}
<div class="container py-5"><h1>Quản trị cộng đồng</h1><section class="card p-4 my-4"><h2>Tài khoản chờ duyệt</h2>@foreach(User u in ViewBag.Pending){<article class="border rounded p-3 my-2"><strong>@u.FullName</strong> · @u.Email<form asp-action="Verify" method="post"><input type="hidden" name="id" value="@u.Id"/><button name="approve" value="true" class="btn btn-primary">Duyệt</button> <button name="approve" value="false" class="btn btn-outline-danger">Từ chối</button></form></article>}</section>
<section class="card p-4 my-4"><h2>Báo cáo vi phạm</h2>@foreach(ViolationReport r in ViewBag.Reports){<article class="border rounded p-3 my-2"><h3>BC@r.Id · @r.Status</h3><p>Người gửi: @r.Reporter.FullName · @r.TargetType #@r.TargetId</p><p>@r.Reason — @r.Description</p><p>Kết quả: @(r.AdminNote??"Chưa có")</p>@if(r.Status != ReportStatus.Resolved && r.Status != ReportStatus.Dismissed){<form asp-action="Resolve" method="post" class="d-grid gap-2"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(r.Version)"/><label>Trạng thái<select name="status" class="form-select"><option value="Investigating">Đang xử lý</option><option value="Resolved">Đã xử lý</option><option value="Dismissed">Từ chối</option></select></label><label>Kết quả<textarea name="note" required minlength="10" maxlength="1000" class="form-control"></textarea></label><button class="btn btn-primary">Lưu</button></form>}</article>}</section></div>

